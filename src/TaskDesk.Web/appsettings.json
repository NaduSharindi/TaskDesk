{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TaskDesk": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "InitializeOnStartup": true
  },
  "Office": {
