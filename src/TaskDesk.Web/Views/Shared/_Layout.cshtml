@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isManager = signedIn && (await AuthorizationService.AuthorizeAsync(User, Policies.ManagerOrAdmin)).Succeeded;
    var isAdmin = signedIn && User.IsInRole(Roles.Admin);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · TaskDesk</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark" aria-hidden="true">✓</span> TaskDesk
        </a>
        @if (signedIn)
        {
            <nav class="nav" aria-label="Main">
                <a asp-controller="Home" asp-action="Index" class="@(controller == "Home" ? "active" : null)">Dashboard</a>
                <a asp-controller="Tasks" asp-action="Index" class="@(controller == "Tasks" ? "active" : null)">Tasks</a>
                @if (isManager)
                {
                    <a asp-controller="Reports" asp-action="Workload" class="@(controller == "Reports" ? "active" : null)">Reports</a>
                }
                @if (isAdmin)
                {
                    <a asp-controller="Audit" asp-action="Index" class="@(controller == "Audit" ? "active" : null)">Audit log</a>
                }
            </nav>
            <div class="user-menu">
                <span class="user-name">@User.FindFirst(AppClaimTypes.FullName)?.Value</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
                </form>
            </div>
        }
    </header>

    <main class="container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success" role="status">@success</div>
        }
        @if (TempData["Warning"] is string warning)
        {
            <div class="alert alert-warning" role="status">@warning</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-error" role="alert">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        TaskDesk v@(typeof(Program).Assembly.GetName().Version?.ToString(3)) · Office time @Clock.ToOfficeTime(Clock.UtcNow).ToString("dd MMM yyyy HH:mm") · Ref @Context.TraceIdentifier
    </footer>
</body>
</html>
